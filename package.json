{
  "name": "pro-kayak-fishing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit": "npm audit --audit-level=high",
    "test:safety": "node --experimental-strip-types --test tests/safety-regression.test.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.0.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/background-runner": "^2.1.0",
    "@capacitor/geolocation": "^7.1.0",
    "suncalc": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "@capacitor/cli": "^7.4.3"
  }
}
